{
  "name": "homepage-astro",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "CMS_URL='http://localhost:3000' astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "pnpm run --no-bail /^lint:.*/",
    "lint:prettier": "prettier --check .",
    "lint:eslint": "eslint .",
    "lint:astro-check": "astro check",
    "lint:svelte-check": "svelte-check --output machine",
    "format": "pnpm run --sequential /^format:.*/",
    "format:prettier": "prettier --write .",
    "format:eslint": "eslint --fix .",
    "test": "playwright test",
    "test:ui": "pnpm run test --ui-host localhost --ui-port 33333",
    "prepare": "node .husky/install.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/node": "9.5.5",
    "@astrojs/svelte": "7.2.5",
    "@astrojs/tailwind": "6.0.2",
    "@melt-ui/svelte": "0.86.6",
    "astro": "5.18.2",
    "clsx": "2.1.1",
    "qs": "6.17.1",
    "svelte": "5.57.3",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@melt-ui/pp": "0.3.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.1",
    "@types/node": "22.20.5",
    "@types/qs": "6.15.1",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "astro-eslint-parser": "3.2.0",
    "embla-carousel": "8.6.0",
    "embla-carousel-svelte": "8.6.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "git-format-staged": "3.1.3",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "sharp": "0.35.5",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "svelte-eslint-parser": "1.10.0",
    "svelte-markdown": "0.4.1",
    "svelte-sequential-preprocessor": "2.0.3",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
